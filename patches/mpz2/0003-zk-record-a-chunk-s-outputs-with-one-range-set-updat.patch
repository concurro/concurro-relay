diff --git a/crates/memory-core/src/store.rs b/crates/memory-core/src/store.rs
index bb2bd62..a4ee111 100644
--- a/crates/memory-core/src/store.rs
+++ b/crates/memory-core/src/store.rs
@@ -118,6 +118,66 @@ impl<T: Copy> Store<T> {
 
         Ok(())
     }
