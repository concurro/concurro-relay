+    /// Returns an error if [`try_set_many`](Self::try_set_many) would reject
+    /// the slices.
+    pub fn check_set_many(&self, slices: impl IntoIterator<Item = Slice>) -> Result<()> {
+        batch_ranges(&self.set, self.items.len(), slices).map(|_| ())
+    }
+
+    /// Attempts to set several slices, recording the set ranges once.
+    ///
+    /// Nothing is written if any slice overlaps data which is already set, is
+    /// out of bounds, or overlaps another slice in the batch.
+    pub fn try_set_many<'a>(
+        &mut self,
+        items: impl IntoIterator<Item = (Slice, &'a [T])>,
+    ) -> Result<()>
+    where
+        T: 'a,
+    {
+        let items: Vec<_> = items.into_iter().collect();
+        let ranges = batch_ranges(
+            &self.set,
+            self.items.len(),
+            items.iter().map(|(slice, _)| *slice),
+        )?;
+
+        for (slice, data) in items {
+            self.items[slice.to_range()].copy_from_slice(data);
+        }
+        self.set |= &ranges;
+
+        Ok(())
+    }
+}
+
+/// Returns the ranges of a batch of slices, or an error if any slice overlaps
+/// `set`, ends past `len`, or overlaps another slice in the batch.
+fn batch_ranges(
+    set: &RangeSet,
+    len: usize,
+    slices: impl IntoIterator<Item = Slice>,
+) -> Result<RangeSet> {
+    let mut batch = Vec::new();
+    for slice in slices {
+        let range = slice.to_range();
+        if !range.is_disjoint(set) {
+            return Err(StoreError::AlreadySet(slice));
+        } else if range.end > len {
+            return Err(StoreError::InvalidSlice(slice));
+        }
+        batch.push((range, slice));
+    }
+
+    batch.sort_unstable_by_key(|(range, _)| range.start);
+    if let Some(pair) = batch.windows(2).find(|pair| pair[1].0.start < pair[0].0.end) {
+        return Err(StoreError::AlreadySet(pair[1].1));
+    }
+
+    Ok(RangeSet::from(
+        batch.into_iter().map(|(range, _)| range).collect::<Vec<_>>(),
+    ))
 }
 
