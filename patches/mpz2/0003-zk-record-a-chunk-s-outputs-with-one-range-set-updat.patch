+    #[test]
+    fn test_try_set_many_matches_sequential() {
+        let mut batched = Store::new();
+        let mut sequential = Store::new();
+        let slices: Vec<_> = (0..4).map(|_| batched.alloc(8)).collect();
+        (0..4).for_each(|_| drop(sequential.alloc(8)));
+
+        let data: Vec<Vec<u8>> = (0..4u8).map(|i| vec![i; 8]).collect();
+        // Out of order and with a gap, as chunked outputs arrive.
+        let order = [2, 0, 3];
+        batched
+            .try_set_many(order.iter().map(|&i| (slices[i], data[i].as_slice())))
+            .unwrap();
+        for &i in &order {
+            sequential.try_set(slices[i], &data[i]).unwrap();
+        }
+
+        assert_eq!(batched.set_ranges(), sequential.set_ranges());
+        for &i in &order {
+            assert_eq!(batched.try_get(slices[i]).unwrap(), &data[i][..]);
+        }
+        assert!(!batched.is_set(slices[1]));
+    }
+
+    #[test]
+    fn test_try_set_many_rejects_invalid_batches_without_writing() {
+        let mut store = Store::new();
+        let a = store.alloc(8);
+        let b = store.alloc(8);
+        let (ones, twos) = (vec![1u8; 8], vec![2u8; 8]);
+
+        // The same slice twice.
+        let duplicate = store.try_set_many([(a, ones.as_slice()), (a, twos.as_slice())]);
+        assert!(matches!(duplicate, Err(StoreError::AlreadySet(_))));
+        assert!(!store.is_set(a));
+
+        // A slice which partially overlaps set data.
+        store.try_set(a, &ones).unwrap();
+        let straddling = Slice::new_unchecked(Ptr::new(4), 8);
+        let partial = store.try_set_many([(straddling, twos.as_slice())]);
+        assert!(matches!(partial, Err(StoreError::AlreadySet(_))));
+        assert!(!store.is_set(b));
+        assert!(store.check_set_many([straddling]).is_err());
+
+        // A slice which is already set.
+        let already = store.try_set_many([(b, twos.as_slice()), (a, twos.as_slice())]);
+        assert!(matches!(already, Err(StoreError::AlreadySet(_))));
+        assert!(!store.is_set(b));
+        assert_eq!(store.try_get(a).unwrap(), &ones[..]);
+    }
+
+    #[test]
+    fn test_bit_store_try_set_many_rejects_duplicates() {
+        let mut store = BitStore::new();
+        let a = store.alloc(4);
+        let b = store.alloc(4);
+        let data = BitVec::from_iter([true, false, true, false]);
+
+        let duplicate = store.try_set_many([(a, data.as_bitslice()), (a, data.as_bitslice())]);
+        assert!(matches!(duplicate, Err(StoreError::AlreadySet(_))));
+        assert!(!store.is_set(a));
+
+        store
+            .try_set_many([(b, data.as_bitslice()), (a, data.as_bitslice())])
+            .unwrap();
+        assert_eq!(store.try_get(a).unwrap(), &data);
+        assert_eq!(store.try_get(b).unwrap(), &data);
+    }
 }
