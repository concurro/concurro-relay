+    /// Marks several outputs as complete at once.
+    pub(crate) fn set_outputs(&mut self, ranges: &RangeSet) -> Result<()> {
+        if let Some(range) = ranges.iter().find(|range| !range.is_subset(&self.output.all)) {
+            return Err(ErrorRepr::NotOutput { range }.into());
+        }
+
+        self.output.complete |= ranges;
+        // If marked for decoding, prove MACs.
+        self.flush.prove |= ranges.intersection(&self.decode.all);
+
+        Ok(())
+    }
+
     pub(crate) fn is_committed(&self, range: Range) -> bool {
         range.is_subset(&self.input.complete) || range.is_subset(&self.output.complete)
     }
