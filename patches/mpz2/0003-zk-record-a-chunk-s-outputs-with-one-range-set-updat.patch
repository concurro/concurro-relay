+    /// Sets the output MACs of several circuits at once.
+    ///
+    /// Returns an error, leaving the store unchanged, if any output is already
+    /// set or overlaps another output in the batch.
+    pub fn set_outputs_macs(&mut self, outputs: &[(Slice, Vec<Mac>)]) -> Result<()> {
+        let ranges = RangeSet::from(
+            outputs
+                .iter()
+                .map(|(slice, _)| slice.to_range())
+                .collect::<Vec<_>>(),
+        );
+        // Validate against every store before changing any of them.
+        self.mac_store
+            .check_set_many(outputs.iter().map(|(slice, _)| *slice))?;
+        self.data_store
+            .check_set_many(outputs.iter().map(|(slice, _)| *slice))?;
+        self.view.set_outputs(&ranges)?;
+
+        self.mac_store
+            .try_set_many(outputs.iter().map(|(slice, macs)| (*slice, macs.as_slice())))?;
+
+        // (Note: LSBs of MACs contain the value of the authenticated bit).
+        let data: Vec<BitVec> = outputs
+            .iter()
+            .map(|(_, macs)| BitVec::from_iter(macs.iter().map(|mac| mac.pointer())))
+            .collect();
+        self.data_store.try_set_many(
+            outputs
+                .iter()
+                .zip(&data)
+                .map(|((slice, _), data)| (*slice, data.as_bitslice())),
+        )?;
+
+        Ok(())
+    }
+
     pub fn send_flush(&mut self, transcript: &mut Hasher) -> Result<ProverFlush> {
         if self.pending {
             return Err(ErrorRepr::UnexpectedFlush.into());
@@ -311,3 +348,30 @@ impl From<ViewError> for ProverStoreError {
         Self(ErrorRepr::View(err))
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rejected_output_batch_leaves_store_unchanged() {
+        let mut store = ProverStore::new();
+        let a = store.alloc_output(8);
+        let b = store.alloc_output(8);
+        let macs = vec![Mac::default(); 8];
+
+        let duplicate = store.set_outputs_macs(&[(b, macs.clone()), (a, macs.clone()), (a, macs.clone())]);
+        assert!(duplicate.is_err());
+        for slice in [a, b] {
+            assert!(!store.is_set_macs(slice));
+            assert!(!store.is_committed_raw(slice));
+        }
+        assert!(!store.wants_flush());
+
+        store.set_outputs_macs(&[(b, macs.clone()), (a, macs)]).unwrap();
+        for slice in [a, b] {
+            assert!(store.is_set_macs(slice));
+            assert!(store.is_committed_raw(slice));
+        }
+    }
+}
