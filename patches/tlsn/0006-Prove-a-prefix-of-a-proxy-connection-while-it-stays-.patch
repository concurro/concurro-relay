+    /// Takes a snapshot, which requires the handshake to be complete and
+    /// the connection to be quiet: everything written has been sent and
+    /// everything received has been read.
+    pub(crate) fn snapshot(&self) -> Result<ProxySnapshot, TlsnError> {
+        let ms = self.ms.peek();
