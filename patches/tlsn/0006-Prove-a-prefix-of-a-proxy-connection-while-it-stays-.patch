+impl Prover<state::CommitAccepted<Proxy>> {
+    /// Commits to a snapshot of a proxy-TLS connection which another prover
+    /// of this session is running, without waiting for that connection to
+    /// close.
+    ///
+    /// Take the snapshot with
+    /// [`ProverControl::snapshot`](crate::prover::ProverControl::snapshot).
+    /// The verifier must call
+    /// [`Verifier::attach`](crate::verifier::Verifier::attach) with the tap
+    /// of the verifier forwarding that connection.
+    ///
+    /// `tags_from` is the number of received records whose tags an earlier
+    /// commitment to this connection already proved; the verifier must pass
+    /// the same number.
+    #[instrument(parent = &self.span, level = "debug", skip_all, err)]
+    pub async fn attach(
+        self,
+        snapshot: ProxySnapshot,
+        tags_from: usize,
+    ) -> Result<Prover<state::Committed>> {
+        let ProverDeps::Proxy(ProverProxyDeps {
+            prover: mut proxy_prover,
+            ..
+        }) = self.state.deps
+        else {
+            unreachable!("proxy-tls received incorrect deps")
+        };
+        let ProxySnapshot {
+            ms,
+            time,
+            traffic,
+            server_name,
+        } = snapshot;
+
+        proxy_prover
+            .send_finished(traffic.tls_sent.len() as u64, traffic.tls_recv.len() as u64)
+            .await?;
+        let (
+            mut ctx,
+            mut vm,
+            TlsOutput {
+                keys,
+                tls_transcript,
+            },
+        ) = proxy_prover.finalize(ms, time, traffic).await?;
+        let transcript =
+            prove_tags(&mut ctx, &mut vm, &keys, &tls_transcript, tags_from).await?;
+
+        Ok(Prover {
+            config: self.config,
+            span: self.span,
+            ctx: Some(ctx),
+            mux_handle: self.mux_handle,
+            closure: self.closure,
+            state: state::Committed {
+                vm,
+                server_name,
+                keys,
+                tls_transcript,
+                transcript,
+            },
+        })
+    }
+}
+
+/// Proves the tags of the received records from index `from` on, and
+/// returns the plaintext transcript.
+async fn prove_tags(
+    ctx: &mut Context,
+    vm: &mut ProverZk,
+    keys: &SessionKeys,
+    tls_transcript: &TlsTranscript,
+    from: usize,
+) -> Result<Transcript> {
+    let records = tls_transcript.recv().get(from..).ok_or_else(|| {
+        Error::internal().with_msg("more record tags were proven than records received")
+    })?;
+
+    // The prover drops the proof output.
+    let _ = verify_tags(
+        vm,
+        (keys.server_write_key, keys.server_write_iv),
+        keys.server_write_mac_key,
+        tls_transcript.version(),
+        records.to_vec(),
+    )
+    .map_err(|err| {
+        Error::internal()
+            .with_msg("tag verification setup failed")
+            .with_source(err)
+    })?;
+
+    vm.execute_all(ctx).await.map_err(|err| {
+        Error::internal()
+            .with_msg("tag verification zk execution failed")
+            .with_source(err)
+    })?;
+
+    debug!("verified tags from server");
+
+    tls_transcript.to_transcript().map_err(|e| {
+        Error::internal()
+            .with_msg("prover could not create transcript")
+            .with_source(e)
+    })
+}
