+        let (Some(sent), Some(recv)) = (
+            record_prefix(&traffic.tls_sent, traffic.app_sent.len()),
+            record_prefix(&traffic.tls_recv, traffic.app_recv.len()),
+        ) else {
+            return Err(TlsnError::internal().with_msg("connection has data in flight"));
+        };
+        traffic.tls_sent.truncate(sent);
+        traffic.tls_recv.truncate(recv);
