         }
@@ -348,6 +364,15 @@ impl TrafficTap {
         self.0.changed.notify_waiters();
     }
 
+    /// Notes that the next `len` bytes recorded from the prover have been
+    /// written to the server.
+    fn wrote(&self, len: usize) {
+        let mut tapped = self.0.tapped.lock().expect("lock is not poisoned");
+        tapped.written += len;
+        let mark = (tapped.written, tapped.recv.len());
+        tapped.sends.push(mark);
+    }
+
     /// Returns everything recorded and the time the prover first sent data.
     pub(crate) fn all(&self) -> (Vec<u8>, Vec<u8>, Option<u64>) {
         let tapped = self.0.tapped.lock().expect("lock is not poisoned");
@@ -365,14 +390,17 @@ impl TrafficTap {
                 if let (Some(prefix), Some(received), Some(time)) =
                     (tapped.sent.get(..sent), tapped.recv.get(..recv), tapped.first_sent)
                 {
-                    // The piece which carried the last of the prefix.
-                    let last = tapped.sends.partition_point(|(end, _)| *end < sent);
-                    let received_then = tapped.sends.get(last).map_or(0, |(_, received)| *received);
+                    // The write which carried the last application data of
+                    // the prefix. If it has not been made, everything
+                    // received so far came before it.
+                    let last_data = last_application_data_end(prefix).unwrap_or(0);
+                    let last = tapped.sends.partition_point(|(end, _)| *end < last_data);
+                    let received_then = tapped.sends.get(last).map_or(tapped.recv.len(), |(_, received)| *received);
                     let known = TapPrefix {
                         sent,
                         received: recv,
                         sent_beyond: tapped.sent.len() - sent,
-                        received_before_last_send: application_data_started_before(received, received_then),
+                        received_at_last_send: if last_data == 0 { 0 } else { received_then },
                     };
                     let taken = (prefix.to_vec(), received.to_vec(), time, known);
                     tapped.sends.drain(..last);
@@ -383,6 +411,14 @@ impl TrafficTap {
         }
     }
 
+    /// Returns the bytes of application data in the records from the server
+    /// which had begun to be forwarded when `received` bytes had been, as
+    /// far as those records have arrived whole.
+    pub fn application_data_started_before(&self, received: usize) -> usize {
+        let tapped = self.0.tapped.lock().expect("lock is not poisoned");
+        application_data_started_before(&tapped.recv, received)
+    }
+
     /// Returns whether the prover has sent application data beyond the first
     /// `sent` bytes it sent. Other records do not count, such as the alert
     /// with which a TLS client answers the server closing the connection.
@@ -401,6 +437,40 @@ pub(crate) struct InspectReader<R> {
     direction: TapDirection,
 }
 
+/// An [`AsyncWrite`] adapter for the connection to the server, which tells
+/// a [`TrafficTap`] when the prover's bytes have been written to it.
+pub(crate) struct InspectWriter<W> {
+    inner: W,
+    tap: TrafficTap,
+}
+
+impl<W> InspectWriter<W> {
+    pub(crate) fn new(inner: W, tap: TrafficTap) -> Self {
+        Self { inner, tap }
+    }
+}
+
+impl<W: AsyncWrite + Unpin> AsyncWrite for InspectWriter<W> {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        let n = ready!(Pin::new(&mut this.inner).poll_write(cx, buf))?;
+        this.tap.wrote(n);
+        Poll::Ready(Ok(n))
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut std::task::Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_flush(cx)
+    }
+
+    fn poll_close(self: Pin<&mut Self>, cx: &mut std::task::Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_close(cx)
+    }
+}
+
 impl<R> InspectReader<R> {
     pub(crate) fn new(inner: R, tap: TrafficTap, direction: TapDirection) -> Self {
         Self {
@@ -607,22 +677,54 @@ mod tests {
