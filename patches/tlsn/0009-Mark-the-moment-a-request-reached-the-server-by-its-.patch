+    /// Records `bytes` from the prover and their write to the server.
+    fn forward(tap: &TrafficTap, bytes: &[u8]) {
+        tap.record(TapDirection::Sent, bytes);
+        tap.wrote(bytes.len());
+    }
+
     #[tokio::test]
-    async fn test_prefix_tells_what_was_received_before_its_last_send() {
+    async fn test_prefix_tells_what_was_received_at_its_last_send_of_application_data() {
         let tap = TrafficTap::default();
         let (first, second) = (app_record(50), app_record(60));
         let (stale, fresh) = (app_record(11), app_record(13));
 
-        tap.record(TapDirection::Sent, &first);
+        forward(&tap, &first);
         tap.record(TapDirection::Recv, &stale);
-        tap.record(TapDirection::Sent, &second);
+        forward(&tap, &second);
         tap.record(TapDirection::Recv, &fresh);
+        // The answer to a server's close does not move the mark.
+        forward(&tap, &record(ALERT, 26));
+
+        let (.., prefix) = tap.prefix(first.len(), 0).await;
+        assert_eq!(prefix.received_at_last_send, 0);
+
+        // Whatever of the received data the prefix covers.
+        let sent = first.len() + second.len() + 31;
+        for received in [0, stale.len(), stale.len() + fresh.len()] {
+            let (.., prefix) = tap.prefix(sent, received).await;
+            assert_eq!(prefix.received_at_last_send, stale.len());
+            assert_eq!(prefix.sent_beyond, 0);
+        }
+        assert_eq!(tap.application_data_started_before(stale.len()), 11);
+        assert_eq!(tap.application_data_started_before(stale.len() + 1), 24);
+    }
 
-        let received = stale.len() + fresh.len();
-        let (.., prefix) = tap.prefix(first.len(), stale.len()).await;
-        assert_eq!(prefix.received_before_last_send, 0);
-        let (.., prefix) = tap.prefix(first.len() + second.len(), received).await;
-        assert_eq!(prefix.received_before_last_send, 11);
-        assert_eq!(prefix.sent_beyond, 0);
+    #[tokio::test]
+    async fn test_what_arrives_before_a_request_is_written_came_before_it() {
+        let tap = TrafficTap::default();
+        let (request, early, late) = (app_record(50), app_record(11), app_record(13));
+
+        // The request has been read from the prover, and the server sends
+        // something before it is written to the server.
+        tap.record(TapDirection::Sent, &request);
+        tap.record(TapDirection::Recv, &early);
+        let (.., prefix) = tap.prefix(request.len(), early.len()).await;
+        assert_eq!(prefix.received_at_last_send, early.len());
+
+        tap.wrote(request.len());
+        tap.record(TapDirection::Recv, &late);
+        let (.., prefix) = tap.prefix(request.len(), early.len() + late.len()).await;
+        assert_eq!(prefix.received_at_last_send, early.len());
     }
 }
