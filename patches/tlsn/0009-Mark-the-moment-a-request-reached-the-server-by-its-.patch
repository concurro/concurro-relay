@@ -267,6 +269,20 @@ fn whole_records(mut tls: &[u8]) -> (Vec<(u8, usize)>, Option<u8>) {
     (records, None)
 }
 
+/// Where the last whole record of application data in the raw TLS stream
+/// `tls` ends, if there is one.
+fn last_application_data_end(tls: &[u8]) -> Option<usize> {
+    let mut end = 0;
+    let mut last = None;
+    for (typ, len) in whole_records(tls).0 {
+        end += len;
+        if typ == APPLICATION_DATA {
+            last = Some(end);
+        }
+    }
+    last
+}
+
 /// Bytes of application data in the records of the raw TLS stream `tls`
 /// which start before offset `before`.
 fn application_data_started_before(tls: &[u8], before: usize) -> usize {
@@ -300,10 +316,12 @@ pub struct TapPrefix {
     /// Bytes the prover had sent beyond the prefix when it was taken. A
     /// prover which has finished its request has none.
     pub sent_beyond: usize,
-    /// Bytes of received application data in records which had begun to
-    /// arrive when the last of the prefix's sent data was forwarded. The
-    /// server sent them without having seen that data.
-    pub received_before_last_send: usize,
+    /// How many bytes had been forwarded from the server when the last
+    /// application data of the prefix had been written to it, whether or
+    /// not the prefix covers them. The server sent them without having seen
+    /// that data. Records which are not application data, such as the alert
+    /// answering a server's close, do not move this.
+    pub received_at_last_send: usize,
 }
 
 /// The raw TLS traffic a proxy verifier has forwarded so far.
@@ -339,8 +357,6 @@ impl TrafficTap {
                     tapped.first_sent = Some(now);
                 }
                 tapped.sent.extend_from_slice(bytes);
-                let mark = (tapped.sent.len(), tapped.recv.len());
-                tapped.sends.push(mark);
