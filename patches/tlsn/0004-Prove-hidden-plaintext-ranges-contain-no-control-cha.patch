+/// Calls [`no_control`] on the plaintext in `ranges`, returning each call's
+/// output.
+///
+/// The plaintext references are the ones authenticated against the
+/// ciphertext, which binds the result to the transcript.
+fn alloc_no_control(
+    vm: &mut dyn Vm<Binary>,
+    plaintext: &ReferenceMap,
+    ranges: &RangeSet<usize>,
+) -> Result<Vec<Array<U8, 1>>, PlaintextAuthError> {
+    let plaintext = plaintext.index(ranges).expect("all ranges are allocated");
+
+    let mut circuits: HashMap<usize, Arc<Circuit>> = HashMap::new();
+    let mut checks = Vec::new();
+    for (_, slice) in plaintext.iter() {
+        let mut pos = 0;
+        while pos < slice.len() {
+            let len = (slice.len() - pos).min(NO_CONTROL_CHUNK);
+            let circuit = circuits
+                .entry(len)
+                .or_insert_with(|| Arc::new(no_control(len)))
+                .clone();
+            let call = Call::builder(circuit)
+                .arg(slice.get(pos..pos + len).expect("length is checked"))
+                .build()
+                .expect("call should be valid");
+
+            checks.push(vm.call(call).map_err(PlaintextAuthError::vm)?);
+            pos += len;
+        }
+    }
+
+    Ok(checks)
+}
+
+/// Returns a circuit which outputs [`NO_CONTROL_OK`] if none of its `len`
+/// input bytes is below `0x20`, and zero otherwise.
+///
+/// `fn([u8; len]) -> u8`
+fn no_control(len: usize) -> Circuit {
+    fn or(builder: &mut CircuitBuilder, x: Node<Feed>, y: Node<Feed>) -> Node<Feed> {
+        let and = builder.add_and_gate(x, y);
+        let xor = builder.add_xor_gate(x, y);
+        builder.add_xor_gate(xor, and)
+    }
+
+    let mut builder = CircuitBuilder::new();
+
+    let mut ok = None;
+    for _ in 0..len {
+        // Bits are little-endian; a byte is at least `0x20` exactly when one
+        // of its top three bits is set.
+        let bits: [Node<Feed>; 8] = std::array::from_fn(|_| builder.add_input());
+        let high = or(&mut builder, bits[5], bits[6]);
+        let high = or(&mut builder, high, bits[7]);
+        ok = Some(match ok {
+            Some(ok) => builder.add_and_gate(ok, high),
+            None => high,
+        });
+    }
+
+    let ok = ok.expect("circuit has at least one input byte");
+    for _ in 0..8 {
+        let bit = builder.add_id_gate(ok);
+        builder.add_output(bit);
+    }
+
+    builder.build().expect("circuit is valid")
+}
