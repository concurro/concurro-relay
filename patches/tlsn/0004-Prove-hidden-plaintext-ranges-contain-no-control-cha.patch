+    /// Proves that every byte in the given ranges of the transcript is at
+    /// least `0x20`, without revealing them.
+    ///
+    /// This rules out CR, LF, NUL and tab, so that hidden data can not alter
+    /// the framing of a line-delimited protocol such as HTTP/1.1. DEL and
+    /// bytes with the high bit set are permitted.
+    pub fn prove_no_control(
+        &mut self,
+        direction: Direction,
+        ranges: impl IntoRangeIterator<usize>,
+    ) -> Result<&mut Self, ProveConfigError> {
+        let idx = RangeSet::from_range_iter(ranges);
+        if idx.end().unwrap_or(0) > self.transcript.len_of_direction(direction) {
+            return Err(ProveConfigError(ErrorRepr::IndexOutOfBounds {
+                direction,
+                actual: idx.end().unwrap_or(0),
+                len: self.transcript.len_of_direction(direction),
+            }));
+        }
+
+        match direction {
+            Direction::Sent => self.no_control.0.union_mut(&idx),
+            Direction::Received => self.no_control.1.union_mut(&idx),
+        }
+
+        Ok(self)
+    }
