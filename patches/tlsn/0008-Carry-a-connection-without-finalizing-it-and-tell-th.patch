                 }
                 tapped.sent.extend_from_slice(bytes);
+                let mark = (tapped.sent.len(), tapped.recv.len());
+                tapped.sends.push(mark);
             }
             TapDirection::Recv => tapped.recv.extend_from_slice(bytes),
         }
@@ -312,22 +355,42 @@ impl TrafficTap {
     }
 
     /// Waits until at least `sent` and `recv` bytes have been forwarded, then
-    /// returns those prefixes, the time the prover first sent data, and how
-    /// many bytes the prover has sent beyond the prefix.
-    pub(crate) async fn prefix(&self, sent: usize, recv: usize) -> (Vec<u8>, Vec<u8>, u64, usize) {
+    /// returns those prefixes, the time the prover first sent data, and what
+    /// else is known of the prefix.
+    pub(crate) async fn prefix(&self, sent: usize, recv: usize) -> (Vec<u8>, Vec<u8>, u64, TapPrefix) {
         loop {
             let changed = self.0.changed.notified();
             {
-                let tapped = self.0.tapped.lock().expect("lock is not poisoned");
-                if let (Some(prefix), Some(recv), Some(time)) =
+                let mut tapped = self.0.tapped.lock().expect("lock is not poisoned");
+                if let (Some(prefix), Some(received), Some(time)) =
                     (tapped.sent.get(..sent), tapped.recv.get(..recv), tapped.first_sent)
                 {
-                    return (prefix.to_vec(), recv.to_vec(), time, tapped.sent.len() - sent);
+                    // The piece which carried the last of the prefix.
+                    let last = tapped.sends.partition_point(|(end, _)| *end < sent);
+                    let received_then = tapped.sends.get(last).map_or(0, |(_, received)| *received);
+                    let known = TapPrefix {
+                        sent,
+                        received: recv,
+                        sent_beyond: tapped.sent.len() - sent,
+                        received_before_last_send: application_data_started_before(received, received_then),
+                    };
+                    let taken = (prefix.to_vec(), received.to_vec(), time, known);
+                    tapped.sends.drain(..last);
+                    return taken;
                 }
             }
             changed.await;
         }
     }
+
+    /// Returns whether the prover has sent application data beyond the first
+    /// `sent` bytes it sent. Other records do not count, such as the alert
+    /// with which a TLS client answers the server closing the connection.
+    pub fn sent_application_data_beyond(&self, sent: usize) -> bool {
+        let tapped = self.0.tapped.lock().expect("lock is not poisoned");
+        let (whole, partial) = whole_records(tapped.sent.get(sent..).unwrap_or_default());
+        whole.iter().map(|(typ, _)| *typ).chain(partial).any(|typ| typ == APPLICATION_DATA)
+    }
 }
 
