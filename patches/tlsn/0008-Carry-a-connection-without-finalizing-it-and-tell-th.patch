diff --git a/crates/tlsn/src/proxy.rs b/crates/tlsn/src/proxy.rs
index 705781045..ca7eb032b 100644
--- a/crates/tlsn/src/proxy.rs
+++ b/crates/tlsn/src/proxy.rs
@@ -245,6 +245,43 @@ struct Tapped {
     sent: Vec<u8>,
     recv: Vec<u8>,
     first_sent: Option<u64>,
+    /// For each piece of data recorded from the prover, the length of
+    /// `sent` once it was added and the length of `recv` at that time.
+    /// Pieces which every taken prefix has passed are dropped.
+    sends: Vec<(usize, usize)>,
+}
+
+/// The whole records at the start of the raw TLS stream `tls`, as their
+/// content type and their length with the header, followed by the content
+/// type of a record which is not whole, if there is one.
+fn whole_records(mut tls: &[u8]) -> (Vec<(u8, usize)>, Option<u8>) {
+    let mut records = Vec::new();
+    while let Some(typ) = tls.first().copied() {
+        let whole = tls.get(3..5).map(|len| 5 + usize::from(u16::from_be_bytes([len[0], len[1]])));
+        let Some(len) = whole.filter(|len| *len <= tls.len()) else {
+            return (records, Some(typ));
+        };
+        records.push((typ, len));
+        tls = &tls[len..];
+    }
+    (records, None)
+}
+
+/// Bytes of application data in the records of the raw TLS stream `tls`
+/// which start before offset `before`.
+fn application_data_started_before(tls: &[u8], before: usize) -> usize {
+    let mut start = 0;
+    let mut app = 0;
+    for (typ, len) in whole_records(tls).0 {
+        if start >= before {
+            break;
+        }
+        if typ == APPLICATION_DATA {
+            app += len.saturating_sub(5 + GCM_RECORD_OVERHEAD);
+        }
+        start += len;
+    }
+    app
 }
 
