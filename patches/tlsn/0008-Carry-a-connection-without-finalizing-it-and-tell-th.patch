+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ALERT: u8 = 21;
+
+    /// A raw record of content type `typ` whose body is `len` bytes.
+    fn record(typ: u8, len: usize) -> Vec<u8> {
+        let mut record = vec![typ, 3, 3];
+        record.extend_from_slice(&(len as u16).to_be_bytes());
+        record.resize(5 + len, 0);
+        record
+    }
+
+    /// An application data record carrying `app` bytes of plaintext.
+    fn app_record(app: usize) -> Vec<u8> {
+        record(APPLICATION_DATA, app + GCM_RECORD_OVERHEAD)
+    }
+
+    #[test]
+    fn test_application_data_started_before_counts_records_which_had_begun() {
+        let tls = [record(22, 40), app_record(100), record(ALERT, 26), app_record(7)].concat();
+        let second_starts = 45 + 5 + 100 + GCM_RECORD_OVERHEAD + 31;
+
+        assert_eq!(application_data_started_before(&tls, 0), 0);
+        assert_eq!(application_data_started_before(&tls, 45), 0);
+        assert_eq!(application_data_started_before(&tls, 46), 100);
+        assert_eq!(application_data_started_before(&tls, second_starts), 100);
+        assert_eq!(application_data_started_before(&tls, second_starts + 1), 107);
+        assert_eq!(application_data_started_before(&tls, tls.len()), 107);
+    }
+
+    #[test]
+    fn test_only_application_data_counts_as_sent_beyond_a_prefix() {
+        let request = app_record(50);
+        let tap = TrafficTap::default();
+        tap.record(TapDirection::Sent, &request);
+        assert!(!tap.sent_application_data_beyond(request.len()));
+
+        // The alert which answers a close, whole or not.
+        let alert = record(ALERT, 26);
+        tap.record(TapDirection::Sent, &alert[..3]);
+        assert!(!tap.sent_application_data_beyond(request.len()));
+        tap.record(TapDirection::Sent, &alert[3..]);
+        assert!(!tap.sent_application_data_beyond(request.len()));
+
+        // Application data, from its first byte.
+        tap.record(TapDirection::Sent, &app_record(9)[..1]);
+        assert!(tap.sent_application_data_beyond(request.len()));
+    }
+
+    #[tokio::test]
+    async fn test_prefix_tells_what_was_received_before_its_last_send() {
+        let tap = TrafficTap::default();
+        let (first, second) = (app_record(50), app_record(60));
+        let (stale, fresh) = (app_record(11), app_record(13));
+
+        tap.record(TapDirection::Sent, &first);
+        tap.record(TapDirection::Recv, &stale);
+        tap.record(TapDirection::Sent, &second);
+        tap.record(TapDirection::Recv, &fresh);
+
+        let received = stale.len() + fresh.len();
+        let (.., prefix) = tap.prefix(first.len(), stale.len()).await;
+        assert_eq!(prefix.received_before_last_send, 0);
+        let (.., prefix) = tap.prefix(first.len() + second.len(), received).await;
+        assert_eq!(prefix.received_before_last_send, 11);
+        assert_eq!(prefix.sent_beyond, 0);
+    }
+}
