@@ -28,6 +28,40 @@ const NO_CONTROL_CHUNK: usize = 256;
 /// Output of [`no_control`] when no byte is below `0x20`.
 const NO_CONTROL_OK: [u8; 1] = [0xff];
 
+/// When a plaintext proof discloses the key the plaintext was encrypted
+/// under, which then authenticates the revealed plaintext directly.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum KeyDisclosure {
+    /// If all of the plaintext is revealed. Whoever holds the key can read
+    /// and forge that direction of the connection from then on, so this is
+    /// for a connection which is over.
+    IfAllRevealed,
+    /// Never.
+    Never,
+    /// Always.
+    Always,
+}
+
+impl KeyDisclosure {
+    /// The disclosure for one direction of a connection which is still
+    /// `open` or not, whose key the prover `asked` to disclose or not.
+    pub(crate) fn of(open: bool, asked: bool) -> Self {
+        match (asked, open) {
+            (true, _) => Self::Always,
+            (false, true) => Self::Never,
+            (false, false) => Self::IfAllRevealed,
+        }
+    }
+
+    fn applies(self, reveal: &RangeSet<usize>, len: usize) -> bool {
+        match self {
+            Self::IfAllRevealed => reveal == (0..len),
+            Self::Never => false,
+            Self::Always => true,
+        }
+    }
+}
