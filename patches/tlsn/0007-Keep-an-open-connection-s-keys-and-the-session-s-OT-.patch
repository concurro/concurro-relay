+    #[test]
+    fn test_key_is_disclosed_unasked_only_once_the_connection_is_over() {
+        let all = RangeSet::from(0..8);
+        let part = RangeSet::from(0..4);
+
+        // A connection which is still open: only on request.
+        assert!(!KeyDisclosure::of(true, false).applies(&all, 8));
+        assert!(KeyDisclosure::of(true, true).applies(&part, 8));
+
+        // A connection which is over: also when everything is revealed.
+        assert!(KeyDisclosure::of(false, false).applies(&all, 8));
+        assert!(!KeyDisclosure::of(false, false).applies(&part, 8));
+        assert!(KeyDisclosure::of(false, true).applies(&part, 8));
+    }
+
+    #[test]
+    fn test_verify_plaintext_rejects_commit_beyond_what_the_key_authenticates() {
+        let (mut vm, key_ref, iv_ref) = build_vm([0u8; 16], [0u8; 4]);
+        let plaintext = vec![0u8; 8];
+        let ciphertext = vec![0u8; 0];
+        let records: Vec<Record> = Vec::new();
+
+        let err = match verify_plaintext(
+            &mut vm,
+            key_ref,
+            iv_ref,
+            &plaintext,
+            &ciphertext,
+            &records,
+            &RangeSet::from(4..8),
+            &RangeSet::from(0..8),
+            &RangeSet::default(),
+            KeyDisclosure::Always,
+        ) {
+            Ok(_) => panic!("verifier accepted a commitment to plaintext it did not check"),
+            Err(err) => err,
+        };
+
+        assert!(matches!(err.0, ErrorRepr::CommitmentNotRevealed));
+    }
