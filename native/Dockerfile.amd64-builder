FROM golang:1.27.4-trixie@sha256:430985542100b871e108ccc00e8dcc5eef08ca14ee5825e98ebf563d8ffec4ee AS go

FROM python:3.15.2-slim-trixie@sha256:63bb298d2b7b88f176f51b5189f54ce6535c997682ea70885d2132f5d473a8a5 AS python
COPY mp-spdz-requirements.txt /tmp/mp-spdz-requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/mp-spdz-requirements.txt

FROM rust:1.100.0-trixie@sha256:e84068000361bf3d4a5ba2b7647f62893528b1eb9f847d7a23b493f5ce8ea254

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config python3 protobuf-compiler \
    libssl-dev libprotobuf-dev libzstd-dev libgmp-dev libmpfr-dev \
    libboost-dev libboost-filesystem-dev libboost-iostreams-dev \
    libboost-thread-dev libsodium-dev libntl-dev yasm patchelf \
    clang-19=1:19.1.7-3+b1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=python /usr/local /usr/local
COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH
