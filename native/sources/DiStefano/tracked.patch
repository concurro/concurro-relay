+// Exercise the real handshake wrapper and compare its private shares with native HKDF.
+TEST_CASE("handoff_private_output_masks") {
+  auto context = CreateContextWithTestCertificate(TLS_method());
+  REQUIRE(context);
+  std::unique_ptr<TLSSocket> client, server;
+  REQUIRE(setup_sockets(context, server, client));
+  using namespace EmpWrapperAG2PCConstants;
+  HandshakeCircuitIn client_in{}, server_in{};
+  HandshakeCircuitOut client_out{}, server_out{};
+  REQUIRE(client_in.key_share.Init(32));
+  REQUIRE(server_in.key_share.Init(32));
+  std::fill(client_in.key_share.begin(), client_in.key_share.end(), 0);
+  std::fill(server_in.key_share.begin(), server_in.key_share.end(), 0);
+  client_in.key_share[31] = 1;
+  server_in.key_share[31] = 2;
+  client_in.hash.fill(0x42);
+  bool client_ok = false, server_ok = false;
+  auto evaluate = [&](bool verifier) {
+    auto *ssl = verifier ? server->get_ssl_object() : client->get_ssl_object();
+    std::unique_ptr<EmpWrapperAG2PC> circuit(
+        EmpWrapperAG2PC::build_derive_hs_256(ssl, verifier ? emp::BOB : emp::ALICE, 0));
+    circuit->do_preproc();
+    if (verifier) {
+      server_ok = ThreePartyHandshake::run_handshake_circuit(server_in, server_out, circuit.get(), true);
+    } else {
+      client_ok = ThreePartyHandshake::run_handshake_circuit(client_in, client_out, circuit.get(), false);
+    }
+  };
+  std::thread peer(evaluate, true);
+  evaluate(false);
+  peer.join();
+  REQUIRE(client_ok);
+  REQUIRE(server_ok);
+  std::array<uint8_t, 32> zero{}, early{}, hs{}, sum{}, ms{};
+  sum[31] = 3;
+  size_t len = 0;
+  const auto *md = EVP_sha256();
+  REQUIRE(HKDF_extract(early.data(), &len, md, zero.data(), zero.size(), zero.data(), zero.size()));
+  const auto des = produce_sublabel("derived", early, client_in.hash);
+  REQUIRE(HKDF_extract(hs.data(), &len, md, sum.data(), sum.size(), des.data(), des.size()));
+  const auto dhs = produce_sublabel("derived", hs, client_in.hash);
+  REQUIRE(HKDF_extract(ms.data(), &len, md, zero.data(), zero.size(), dhs.data(), dhs.size()));
+  std::array<uint8_t, 32> reconstructed{}, public_masked{};
+  for (size_t i = 0; i < 16; ++i) {
+    reconstructed[i] = client_out.MS_share[i];
+    reconstructed[16+i] = server_out.MS_share[i];
+    public_masked[i] = client_out.MS_share[i] ^ client_out.xor_mask[64+i];
+    public_masked[16+i] = server_out.MS_share[i] ^ server_out.xor_mask[64+i];
+  }
+  CHECK(reconstructed == ms);
+  CHECK(public_masked != ms);
+  CHECK(std::any_of(client_out.xor_mask.begin(), client_out.xor_mask.end(), [](auto x) { return x != 0; }));
+  CHECK(std::any_of(server_out.xor_mask.begin(), server_out.xor_mask.end(), [](auto x) { return x != 0; }));
+  const auto shts = produce_sublabel("s hs traffic", hs, client_in.hash);
