+  bssl::BN_CTXScope scope(ctx.get());
+  bssl::UniquePtr<EC_GROUP> group(EC_GROUP_new_by_curve_name(NID_X9_62_prime256v1));
+  bssl::UniquePtr<EC_POINT> ap(EC_POINT_new(group.get())), bp(EC_POINT_new(group.get())), sum(EC_POINT_new(group.get()));
+  auto scalar = BN_CTX_get(ctx.get()), x = BN_CTX_get(ctx.get()), y = BN_CTX_get(ctx.get()), p = BN_CTX_get(ctx.get());
+  REQUIRE(p);
+  REQUIRE(BN_set_word(scalar, 3));
+  REQUIRE(EC_POINT_mul(group.get(), ap.get(), scalar, nullptr, nullptr, ctx.get()));
+  REQUIRE(BN_set_word(scalar, 5));
+  REQUIRE(EC_POINT_mul(group.get(), bp.get(), scalar, nullptr, nullptr, ctx.get()));
+  bool should_accept = true;
+  SUBCASE("valid") {}
+  SUBCASE("changed masks") { alice[96] ^= 0xf5; bob[127] ^= 0x19; }
+  bool changed_handshake_masks = false;
+  SUBCASE("changed Bob handshake masks") {
+    bob[128] ^= 0xf5;
+    bob[191] ^= 0x19;
+    changed_handshake_masks = true;
+  }
+  SUBCASE("mismatched transcript") { bob[64] ^= 1; should_accept = false; }
+  SUBCASE("point at infinity") {
+    REQUIRE(EC_POINT_copy(bp.get(), ap.get()));
+    REQUIRE(EC_POINT_invert(group.get(), bp.get(), ctx.get()));
+    should_accept = false;
+  }
+  for (auto pair : {std::make_pair(ap.get(), &alice), std::make_pair(bp.get(), &bob)}) {
+    REQUIRE(EC_POINT_get_affine_coordinates_GFp(group.get(), pair.first, x, y, ctx.get()));
+    REQUIRE(BN_bn2bin_padded(pair.second->data(), 32, x));
+    REQUIRE(BN_bn2bin_padded(pair.second->data() + 32, 32, y));
+  }
+  SUBCASE("noncanonical coordinate") {
+    REQUIRE(EC_GROUP_get_curve_GFp(group.get(), p, nullptr, nullptr, ctx.get()));
+    REQUIRE(BN_bn2bin_padded(alice.data(), 32, p));
+    should_accept = false;
+  }
+  emp::setup_plain_prot(false, "");
+  const auto output = HandoffHandshake::evaluate(alice, bob);
+  emp::finalize_plain_prot();
+  if (!should_accept) {
+    CHECK(std::all_of(output.begin(), output.end(), [](auto v) { return v == 0; }));
+    return;
+  }
+  REQUIRE(output[0] == 1);
+  REQUIRE(EC_POINT_add(group.get(), sum.get(), ap.get(), bp.get(), ctx.get()));
+  REQUIRE(EC_POINT_get_affine_coordinates_GFp(group.get(), sum.get(), x, nullptr, ctx.get()));
+  std::array<uint8_t, 32> dhe{}, zero{}, early{}, hs{}, ms{}, h2{}, bob_share{}, exposed{};
+  h2.fill(0x42);
+  REQUIRE(BN_bn2bin_padded(dhe.data(), dhe.size(), x));
+  size_t len = 0;
+  REQUIRE(HKDF_extract(early.data(), &len, EVP_sha256(), zero.data(), zero.size(), zero.data(), zero.size()));
+  const auto des = produce_sublabel("derived", early, h2);
+  REQUIRE(HKDF_extract(hs.data(), &len, EVP_sha256(), dhe.data(), dhe.size(), des.data(), des.size()));
+  const auto dhs = produce_sublabel("derived", hs, h2);
+  REQUIRE(HKDF_extract(ms.data(), &len, EVP_sha256(), zero.data(), zero.size(), dhs.data(), dhs.size()));
+  const auto chts = produce_sublabel("c hs traffic", hs, h2);
+  const auto shts = produce_sublabel("s hs traffic", hs, h2);
+  if (changed_handshake_masks) {
+    auto original_bob = bob;
+    original_bob[128] ^= 0xf5;
+    original_bob[191] ^= 0x19;
+    emp::setup_plain_prot(false, "");
+    const auto baseline = HandoffHandshake::evaluate(alice, original_bob);
+    emp::finalize_plain_prot();
+    CHECK(output[1] == (baseline[1] ^ 0xf5));
+    CHECK(output[64] == (baseline[64] ^ 0x19));
+    CHECK(std::equal(output.begin() + 2, output.begin() + 64, baseline.begin() + 2));
+    CHECK(std::equal(output.begin() + 65, output.end(), baseline.begin() + 65));
+  }
+  for (size_t i = 0; i < 32; ++i) {
+    CHECK((output[1+i] ^ bob[128+i]) == chts[i]);
+    CHECK((output[33+i] ^ bob[160+i]) == shts[i]);
+  }
+  std::string handshake_message = "Concurro/Handoff/v2/handshake-keys";
+  handshake_message.append(reinterpret_cast<const char *>(h2.data()), h2.size());
+  handshake_message.append(reinterpret_cast<const char *>(chts.data()), chts.size());
+  handshake_message.append(reinterpret_cast<const char *>(shts.data()), shts.size());
+  std::array<uint8_t, 32> handshake_commitment{};
+  SHA256(reinterpret_cast<const uint8_t *>(handshake_message.data()), handshake_message.size(), handshake_commitment.data());
+  CHECK(std::equal(handshake_commitment.begin(), handshake_commitment.end(), output.begin()+161));
+  for (size_t i = 0; i < 32; ++i) {
+    exposed[i] = output[65 + i];
+    bob_share[i] = exposed[i] ^ bob[96 + i];
+    CHECK((bob_share[i] ^ alice[96 + i]) == ms[i]);
+  }
+  CHECK(exposed != ms);
+  for (const bool side_b : {false, true}) {
+    std::string message = side_b ? "Concurro/Handoff/v1/MS/B" : "Concurro/Handoff/v1/MS/A";
+    message.append(reinterpret_cast<const char *>(h2.data()), h2.size());
+    message.append(reinterpret_cast<const char *>(side_b ? bob_share.data() : alice.data() + 96), 32);
+    std::array<uint8_t, 32> expected{};
+    SHA256(reinterpret_cast<const uint8_t *>(message.data()), message.size(), expected.data());
+    CHECK(std::equal(expected.begin(), expected.end(), output.begin() + (side_b ? 129 : 97)));
+  }
+}
