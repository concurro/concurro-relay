@@ -25,6 +31,51 @@ extern "C" {
 
 using namespace std;
 
+#ifdef HANDOFF_MRR_BASE_OT
+namespace {
+/** Present MP-SPDZ's framed player messages as a byte stream to MRR. */
+struct MrrChannel
+{
+    TwoPartyPlayer* player;
+    vector<octet> pending;
+    size_t offset = 0;
+};
+
+/** Send one MRR message over MP-SPDZ's existing two-party channel. */
+void mrr_send_bytes(void* context, const void* data, size_t size)
+{
+    octetStream message;
+    message.append(static_cast<const octet*>(data), size);
+    static_cast<MrrChannel*>(context)->player->send(message);
+}
+
+/** Receive one exact MRR message over MP-SPDZ's existing two-party channel. */
+void mrr_receive_bytes(void* context, void* data, size_t size)
+{
+    auto& channel = *static_cast<MrrChannel*>(context);
+    size_t copied = 0;
+    while (copied < size)
+    {
+        if (channel.offset == channel.pending.size())
+        {
+            octetStream message;
+            channel.player->receive(message);
+            channel.pending.assign(message.get_data(),
+                                   message.get_data() + message.get_length());
+            channel.offset = 0;
+            if (channel.pending.empty())
+                throw invalid_length("MRR base OT empty frame");
+        }
+        auto count = min(size - copied, channel.pending.size() - channel.offset);
+        memcpy(static_cast<octet*>(data) + copied,
+               channel.pending.data() + channel.offset, count);
+        copied += count;
+        channel.offset += count;
+    }
+}
+}
+#endif
+
 const char* role_to_str(OT_ROLE role)
 {
     if (role == RECEIVER)
@@ -145,12 +196,68 @@ bool BaseOT::use_avx()
 
 void BaseOT::exec_base(bool new_receiver_inputs)
 {
+#ifdef HANDOFF_MRR_BASE_OT
+    if (nOT != 128)
+        throw invalid_length("MRR base OT count");
+    PRNG random;
+    random.ReSeed();
+    allocate();
+    array<bool, 128> choices;
+    array<unsigned char, 128 * AES_BLK_SIZE> selected, first, second;
+    MrrChannel channel{P, {}, 0};
+    if (ot_role & RECEIVER)
+        for (int i = 0; i < nOT; ++i)
+        {
+            if (new_receiver_inputs)
+                receiver_inputs[i] = random.get_uchar() & 1;
+            choices[i] = receiver_inputs[i].get();
+        }
+
+    // Opposite role order keeps both authenticated players on the same stream.
+    auto send_base = [&] {
+        handoff_base_ot_send(&channel, mrr_send_bytes, mrr_receive_bytes,
+                             first.data(), second.data());
+        for (int i = 0; i < nOT; ++i)
+            for (int j = 0; j < AES_BLK_SIZE; ++j)
+            {
+                sender_inputs[i][0].set_byte(j, first[i * AES_BLK_SIZE + j]);
+                sender_inputs[i][1].set_byte(j, second[i * AES_BLK_SIZE + j]);
+            }
+    };
+    auto receive_base = [&] {
+        handoff_base_ot_receive(&channel, mrr_send_bytes, mrr_receive_bytes,
+                                choices.data(), selected.data());
+        for (int i = 0; i < nOT; ++i)
+            for (int j = 0; j < AES_BLK_SIZE; ++j)
+                receiver_outputs[i].set_byte(j, selected[i * AES_BLK_SIZE + j]);
+    };
+    if (ot_role == BOTH)
+    {
+        if (P->my_num() == 0) { send_base(); receive_base(); }
+        else { receive_base(); send_base(); }
+    }
+    else if (ot_role == SENDER)
+        send_base();
+    else
+        receive_base();
+
+    for (int i = 0; i < nOT; ++i)
+    {
+        if (ot_role & RECEIVER)
+            hash_with_id(receiver_outputs[i], i);
+        if (ot_role & SENDER)
+            for (int j = 0; j < 2; ++j)
+                hash_with_id(sender_inputs[i][j], i);
+    }
+    set_seeds();
+#else
 #ifndef NO_AVX_OT
     if (use_avx())
         exec_base<SIMPLEOT_SENDER, SIMPLEOT_RECEIVER>(new_receiver_inputs);
     else
 #endif
         exec_base<ref10_SENDER, ref10_RECEIVER>(new_receiver_inputs);
+#endif
 }
 
