FROM --platform=linux/amd64 debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates libboost-filesystem1.83.0 libboost-iostreams1.83.0 \
    libbz2-1.0 libgmp10 libgmpxx4ldbl libsodium23 libssl3t64 \
    libzstd1 liblzma5 zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY package-concurro-v3/ /opt/concurro/

ENV PATH=/opt/concurro/bin:$PATH \
    CONCURRO_NATIVE_BUNDLE=/opt/concurro/native-runtime \
    CONCURRO_NATIVE_OUTPUT=/data/sessions \
    LD_LIBRARY_PATH=/opt/concurro/native-runtime/runtime/DiStefano/build/emp-tool:/opt/concurro/native-runtime/runtime/MP-SPDZ

WORKDIR /opt/concurro
ENTRYPOINT ["concurro-relay-hosted"]
